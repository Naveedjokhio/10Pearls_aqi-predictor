# Copy this file to .env and fill in your real values
# NEVER commit the actual .env file to Git

# OpenWeather API key - get from https://openweathermap.org/api (Air Pollution API, free tier)
# Note: AQICN has no active ground station for Karachi/Sindh (confirmed via
# their map/bounds API returning zero stations), so this project uses
# OpenWeather instead - the other API explicitly allowed by the project instructions.
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Cities are hardcoded in feature_pipeline/fetch_features.py (CITIES dict):
# karachi, lahore, islamabad, faisalabad, rawalpindi, peshawar

# How many days of history to pull in backfill.py
BACKFILL_DAYS=10

# GCP project (reuse your existing project or create a new one)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1

# Feature Store (BigQuery dataset/table, backing Vertex AI)
BQ_DATASET=aqi_predictor
BQ_TABLE=aqi_features_pakistan

# GCS bucket used to stage the trained model before registering it in
# the Vertex AI Model Registry
GCS_BUCKET=your-gcs-bucket-name
